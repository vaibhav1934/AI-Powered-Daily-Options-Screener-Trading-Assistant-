# =============================================================================
# AI-Powered Daily Options Screener — Environment Variables
# Copy this to .env and fill in your values.
# =============================================================================

# --- AI Model Authentication (isolated from all other auth) ---
# Set VERTEX_AI=true to use Google ADC (Vertex AI-hosted Claude).
# Set VERTEX_AI=false (or omit) to use direct API keys.
VERTEX_AI=false

# Required when VERTEX_AI=false. Only ANTHROPIC is implemented in v1.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=  # Reserved for future use — not implemented in v1.

# Required when VERTEX_AI=true
# GCP_PROJECT_ID=
# GCP_REGION=us-east5

# --- Market Data APIs (separate from AI auth) ---
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/options_screener

# --- Supabase Storage (for screenshots) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# --- App Settings ---
# Timezone for all cutoff logic (do not change)
APP_TIMEZONE=America/Chicago

# Pre-market scan time (24h format, CST)
SCAN_SCHEDULE_HOUR=6
SCAN_SCHEDULE_MINUTE=30

# Cutoff times (CST) — defaults match framework rules
CUTOFF_STANDARD=11:00
CUTOFF_FRIDAY=10:30
CUTOFF_FOMC=12:45

# Cache TTL for market data (seconds)
CACHE_TTL_FINNHUB=300
CACHE_TTL_ALPHA_VANTAGE=86400
